# Node-local environment (AGENTS_MODE, secrets)
.env

# Compiled binaries
apps/*/skoed
apps/*/*.exe

# Go build artifacts
apps/*/vendor/

# Editor / OS noise
.DS_Store
*.swp
*.swo
*~

# Temp files
*.tmp
*.bak

# Web UI build artefacts — committed at apps/skoed/internal/api/static/dist
# instead so the Go binary's go:embed slot is populated.
web/node_modules/
web/dist/

# Traceability tool output (regenerated on demand)
traceability-report.md
web/tsconfig.tsbuildinfo

# Release artefacts (goreleaser / make deb output)
dist/
# …except the embedded SPA bundle the Go binary needs at compile time.
!apps/skoed/internal/api/static/dist/

# Browser extension zips (built by make build-extension, uploaded to GitHub releases)
extensions/
.claude/
