# Maintainer: skoed maintainers <maintainers@skoed.io>
pkgname=skoed
pkgver=0.1.2
pkgrel=1
pkgdesc="Self-hosted DNS filtering with multi-node sync (Pi-Hole / AdGuard Home replacement)"
arch=('x86_64' 'aarch64')
url="https://github.com/ashmonger/skoed"
license=('MIT')
depends=()
optdepends=('systemd: service management')
provides=('skoed')
conflicts=('skoed-bin' 'skoed-git')

source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/ashmonger/skoed/releases/download/v${pkgver}/skoed_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/ashmonger/skoed/releases/download/v${pkgver}/skoed_${pkgver}_linux_arm64.tar.gz")

# Updated by CI on each release via: makepkg --geninteg
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 skoed "${pkgdir}/usr/bin/skoed"

    # Default config — installed only if /etc/skoed/config.yaml does not exist.
    # Users manage this file; it is not replaced on upgrade.
    install -Dm644 /dev/null "${pkgdir}/etc/skoed/.keep"

    # Data and log dirs
    install -dm700 "${pkgdir}/var/lib/skoed"
    install -dm750 "${pkgdir}/var/log/skoed"
}

post_install() {
    if ! id -u skoed &>/dev/null; then
        useradd --system --no-create-home --shell /usr/bin/nologin \
                --home-dir /var/lib/skoed skoed
    fi
    chown skoed:skoed /var/lib/skoed /var/log/skoed
    echo "  -> Enable and start the service:"
    echo "       systemctl enable --now skoed"
}

post_upgrade() {
    systemctl try-restart skoed.service 2>/dev/null || true
}

pre_remove() {
    systemctl disable --now skoed.service 2>/dev/null || true
}

post_remove() {
    if id -u skoed &>/dev/null; then
        userdel skoed 2>/dev/null || true
    fi
}
