[Unit]
Description=skoed — self-hosted DNS filtering with multi-node sync
Documentation=https://github.com/skoed/skoed
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/skoed --config /etc/skoed/config.yaml
Restart=on-failure
RestartSec=3

User=skoed
Group=skoed

# Bind privileged DNS ports (UDP/TCP 53) as the unprivileged skoed user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening — should match the assumptions in TS-NativePackaging.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/skoed /var/log/skoed

[Install]
WantedBy=multi-user.target
