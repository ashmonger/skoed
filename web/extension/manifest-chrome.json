{
  "manifest_version": 3,
  "name": "skoed",
  "version": "1.0.0",
  "description": "Push notifications from your skoed DNS filter",
  "permissions": [
    "notifications",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "skoed"
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "128": "icons/icon-128.png"
  }
}
